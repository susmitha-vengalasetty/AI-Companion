# ============================================================
# AI Study Companion - backend configuration
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# ============================================================

PORT=5000
NODE_ENV=development

# ---- MongoDB Atlas (required) ----
# No MongoDB Memory Server, no local fallback. If this fails, the server exits.
MONGODB_URI=

# ---- Auth (required) ----
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ============================================================
# Google Gemini  (the ONLY AI provider in this project)
# Free key, no credit card: https://aistudio.google.com/apikey
# ============================================================
# One key powers both the LLM and embeddings.
GEMINI_API_KEY=

# LLM for AI Tutor, quiz generation and grading.
# gemini-3-flash is Google's recommended free-tier model.
# Do NOT set a Pro model: Pro moved to paid-only on 1 April 2026.
# Run `node scripts/reindex.mjs --check` to list models your key can use.
GEMINI_MODEL=gemini-3-flash

# ---- Embeddings ----
# gemini-embedding-2 is generally available: 8,192 input tokens,
# output dimensions configurable 128-3072.
# Do NOT use text-embedding-004 (retired 14 Jan 2026) or embedding-001
# (retired 14 Aug 2025).
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2

# Google recommends 768, 1536 or 3072. 768 is the quality/size sweet spot and
# keeps in-Node scoring fast on a modest laptop. The returned length is
# validated against this on every vector - never padded or truncated.
# Changing this makes the existing index stale; you must re-index.
EMBEDDING_DIMENSIONS=768

# ============================================================
# RAG tuning
# ============================================================
# Minimum blended score for a chunk to count as evidence.
# finalScore = (1 - RAG_LEXICAL_WEIGHT) * semantic + RAG_LEXICAL_WEIGHT * lexical
#
# LEAVE BLANK UNTIL CALIBRATED. The built-in default is a guess - Google
# publishes no score distribution for gemini-embedding-2.
# Calibrate with:  node scripts/evaluate-retrieval.mjs
RAG_MIN_SIMILARITY=
RAG_TOP_K=5
RAG_LEXICAL_WEIGHT=0.15

# ---- Free-tier pacing ----
# batchEmbedContents counts as ONE request regardless of batch size, so ~730
# chunks becomes ~37 requests. The delay keeps RPM/TPM inside free-tier limits.
# Raise the delay if you see 429 RESOURCE_EXHAUSTED - 1500ms was too fast for
# this key's RPM limit; 5000-6000ms is a safer starting point.
RAG_EMBEDDING_BATCH_SIZE=20
RAG_EMBEDDING_BATCH_DELAY_MS=5000

# ---- Retry backoff for a single batch that gets a 429 ----
# Doubles each attempt starting from the base, capped at the max, before
# giving up on that batch. Whatever was embedded in EARLIER batches is
# already saved by then (see pdfProcessingService) - only the unsent
# remainder needs re-sending, via the Retry button, once the limit clears.
RAG_EMBEDDING_RETRY_BASE_MS=3000
RAG_EMBEDDING_RETRY_MAX_MS=60000
RAG_EMBEDDING_MAX_RETRIES=5

# Logs retrieval decisions (query, candidate count, top scores, threshold
# outcome). Never logs API keys or connection strings.
RAG_DEBUG=false
